# 模型提供方：stub（离线，无需 key）| siliconflow（硅基流动）| openai
QAGENT_MODEL_PROVIDER=stub

# ---- siliconflow provider（读下列环境变量，和 init_chat_model 一致）----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# ---- openai provider（或任意 OpenAI 兼容接口）----
QAGENT_MODEL_NAME=gpt-4o-mini
QAGENT_OPENAI_API_KEY=
QAGENT_OPENAI_BASE_URL=

# 存储路径
QAGENT_DATA_DIR=./data
QAGENT_ARTIFACT_DIR=./artifacts
# 回测结果 / 实验记录（SQLite，结果外置）
QAGENT_RESULTS_DB=./data/results.sqlite

# ---- Checkpoint 后端 ----
# memory：单进程内存（测试/演示）；sqlite：SQLite 持久化，跨进程断点恢复
QAGENT_CHECKPOINT_BACKEND=sqlite
QAGENT_CHECKPOINT_DB=./data/checkpoints.sqlite

# ---- Harness：工具调用预算 / 超时 / 重试 ----
QAGENT_MAX_ITERATIONS=10
QAGENT_MAX_TOOL_CALLS=30
QAGENT_TOOL_TIMEOUT_SECONDS=30.0
QAGENT_TOOL_RETRIES=1
QAGENT_TOOL_RETRY_BACKOFF_SECONDS=0.5

# ---- GraphRAG 知识库（本地 graphrag.api 查询，不启用则 search_financial_knowledge 用桩）----
QAGENT_GRAPHRAG_ENABLED=false
# 本地 graphrag 根目录（settings.yaml + out/ 所在）；留空则用包内 src/qagent/data
QAGENT_GRAPHRAG_ROOT=
