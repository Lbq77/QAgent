# 模型提供方：stub（离线，无需 key）| siliconflow（硅基流动）| openai
QAGENT_MODEL_PROVIDER=stub

# ---- siliconflow provider（读下列环境变量，和 init_chat_model 一致）----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# ---- openai provider（或任意 OpenAI 兼容接口）----
QAGENT_MODEL_NAME=gpt-4o-mini
QAGENT_OPENAI_API_KEY=
QAGENT_OPENAI_BASE_URL=

# 存储路径
QAGENT_DATA_DIR=./data
QAGENT_ARTIFACT_DIR=./artifacts
